# Copy to .env.local for local work, and add the same keys in
# Vercel > Project > Settings > Environment Variables.

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Leave empty to
# disable GA; events are then printed to the browser console instead.
NEXT_PUBLIC_GA_ID=

# Formspree form ID for "Ask the Map" (the part after /f/ in your form URL).
NEXT_PUBLIC_FORMSPREE_ID=

# Public URL of the deployed site, used for share links and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://passport-stories.vercel.app
